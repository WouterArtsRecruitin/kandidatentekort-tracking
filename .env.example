# Environment Variables voor Netlify
# Copy deze waarden naar: Netlify Dashboard → Site Settings → Environment Variables

# Facebook Conversions API
FACEBOOK_API_TOKEN=YOUR_FACEBOOK_API_TOKEN_HERE

# Facebook App Secret (voor advanced matching)
META_APP_SECRET=YOUR_META_APP_SECRET_HERE

# Pixel ID is hardcoded in HTML en functions: YOUR_PIXEL_ID_HERE
